{
    "$schema": "https://opencode.ai/config.json",
    "model": "opencode/mimo-v2.5-free",
    "lsp": true,
    "autoupdate": true,
    "instructions": [
        "AGENTS.md",
        "docs/api-guidelines.md",
        "docs/database-schema.md",
        "src/db/schema/**/*.ts"
    ],
    "mcp": {
        "mysql": {
            "command": ["npx", "-y", "@f4ww4z/mcp-mysql-server", "mysql://khoican:basmalah123@localhost:3307/skripsi_db"],
            "type": "local",
            "enabled": true
        },
        "github": {
            "type": "remote",
            "url": "https://api.githubcopilot.com/mcp/",
            "headers": {
                "Authorization": "Bearer ${GITHUB_PAT}"
            },
            "enabled": true
        },
        "filesystem": {
            "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "/home/khoican/project/skripsi/backend"],
            "type": "local",
            "enabled": true
        },
        "sequential-thinking": {
            "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
            "type": "local",
            "enabled": true
        },
        "memory": {
            "command": ["docker", "run", "-i", "-v", "claude-memory:/app/dist", "--rm", "mcp/memory"],
            "type": "local",
            "enabled": true
        },
        "fetch": {
            "command": ["npx", "mcp-fetch-server"],
            "type": "local",
            "enabled": true
        }
    },
    "permission": {
        "edit": "allow",
        "bash": "allow"
    },
    "agent": {
        "db-schema": {
            "description": "Agent khusus untuk mengelola schema Drizzle ORM dan migration MySQL. Fokus pada type safety dan konsistensi schema.",
            "model": "mimo/mimo-v2.5-pro",
            "prompt": "Kamu adalah spesialis Drizzle ORM dengan MySQL. Selalu pastikan schema type-safe, gunakan drizzle-kit untuk generate migration, dan jangan pernah menjalankan migration langsung ke production tanpa konfirmasi eksplisit dari user. Ikuti konvensi penamaan tabel dan kolom yang sudah ada di project.",
            "tools": {
                "write": true,
                "edit": true,
                "bash": true
            }
        },
        "api-reviewer": {
            "description": "Review endpoint Fastify untuk validasi, error handling, dan konsistensi response format. Read-only, tidak mengubah kode.",
            "model": "mimo/mimo-v2.5",
            "prompt": "Kamu adalah code reviewer untuk REST API berbasis Fastify + TypeScript. Fokus review pada: skema validasi request/response (misal pakai zod atau TypeBox), error handling, status code yang tepat, dan konsistensi struktur response JSON. Jangan mengubah file, cukup berikan feedback.",
            "tools": {
                "write": false,
                "edit": false
            }
        }
    },
    "share": "manual"
}