# === Application ===
# Mode: development | production | test
NODE_ENV=development
# Server port
PORT=3000
# Server bind address (0.0.0.0 = all interfaces)
HOST=0.0.0.0

# === Database ===
# For local MariaDB/MySQL (port 3306, no SSL)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=password
DATABASE_NAME=skripsi_db

# For TiDB Cloud (port 4000, SSL auto-detected)
# DATABASE_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# DATABASE_PORT=4000
# DATABASE_USER=root.xxxx
# DATABASE_PASSWORD=your_password
# DATABASE_NAME=skripsi_db

# === Authentication ===
# JWT signing secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_jwt_secret_here
# Cookie signing secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
COOKIE_SECRET=your_cookie_secret_here

# === Cookie Configuration ===
# SameSite: strict | lax | none (default: lax)
# - strict: Cookie hanya dikirim saat same-site request
# - lax: Cookie dikirim saat top-level navigation (default browser)
# - none: Cookie dikirim semua (wajib secure: true)
COOKIE_SAMESITE=lax
# Secure: true | false (default: false)
# - true: Cookie hanya dikirim via HTTPS (aktifkan di production)
COOKIE_SECURE=false
# Domain: optional, contoh: .example.com (untuk subdomain sharing)
# COOKIE_DOMAIN=.example.com
# Path: default "/" untuk access token
COOKIE_PATH=/
# Refresh cookie path: batasi path refresh token
REFRESH_COOKIE_PATH=/api/auth/refresh

# === ImageKit ===
# ImageKit public key (from Dashboard > Developer > API Keys)
IMAGEKIT_PUBLIC_KEY=your_public_key
# ImageKit private key (from Dashboard > Developer > API Keys)
IMAGEKIT_PRIVATE_KEY=your_private_key
# ImageKit URL endpoint (from Dashboard > General Settings)
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# === CORS ===
# Comma-separated allowed origins (kosongkan untuk reflect semua di dev)
# Contoh: http://localhost:3000,https://mysite.com
CORS_ORIGINS=

# === Server ===
# Aktifkan jika di belakang reverse proxy (Vercel, nginx, Cloudflare)
# Membaca IP client asli untuk rate limit dan logging
TRUST_PROXY=false
# API key untuk bulk product upload (endpoint public via x-api-key)
BULK_UPLOAD_KEY=
