# === Application ===
# Mode: development | production | test
NODE_ENV=development
# Server port
PORT=3000
# Server bind address (0.0.0.0 = all interfaces)
HOST=0.0.0.0

# === Database ===
# For local MariaDB/MySQL (port 3306, no SSL)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=password
DATABASE_NAME=skripsi_db

# For TiDB Cloud (port 4000, SSL auto-detected)
# DATABASE_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# DATABASE_PORT=4000
# DATABASE_USER=root.xxxx
# DATABASE_PASSWORD=your_password
# DATABASE_NAME=skripsi_db

# === Authentication ===
# JWT signing secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_jwt_secret_here
# Cookie signing secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
COOKIE_SECRET=your_cookie_secret_here

# === ImageKit ===
# ImageKit public key (from Dashboard > Developer > API Keys)
IMAGEKIT_PUBLIC_KEY=your_public_key
# ImageKit private key (from Dashboard > Developer > API Keys)
IMAGEKIT_PRIVATE_KEY=your_private_key
# ImageKit URL endpoint (from Dashboard > General Settings)
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
