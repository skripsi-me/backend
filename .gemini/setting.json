{
  "project": {
    "name": "Fastify-Backend",
    "environment": "development"
  },
  "llm": {
    "model": "gemini-3-flash",
    "temperature": 0,
    "maxOutputTokens": 8192
  },
  "context": {
    "respectGitIgnore": true,
    "ignorePatterns": [
      "node_modules/**",
      "dist/**",
      ".git/**"
    ]
  },
  "execution": {
    "allowAutoRun": false,
    "shellConfig": {
      "windows": "cmd.exe",
      "linux": "/bin/bash",
      "mac": "/bin/zsh"
    },
    "alias": {
      "npm": "npm.cmd",
      "npx": "npx.cmd"
    },
    "allowedCommands": [
      "npm",
      "npx",
      "tsc",
      "vitest",
      "mkdir",
      "echo"
    ]
  }
}
